source "https://rubygems.org"

# Unrestricted Jekyll 4.x branch allows compilation against modern Ruby C headers
gem "jekyll", "~> 4.3"

# WEBrick was extracted from the Ruby standard library in 3.0.
# It must be explicitly declared to spawn the local development server.
gem "webrick"

# Standard pipeline plugins
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
end
gem "jekyll-sitemap", "~> 1.4"
